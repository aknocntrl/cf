#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    string base="";
    while(base.size()<60){
        base+="Yes";}
    while(t--){
        string s;
        cin>>s;
        if(base.find(s)!=string::npos){
            cout<<"YES"<<endl;}
        else{
            cout<<"NO"<<endl;}}
    return 0;
}